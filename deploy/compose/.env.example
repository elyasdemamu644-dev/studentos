# Tutor Walle free-tier deployment configuration template.
# Copy to deploy/compose/.env and set values locally. Never commit it.
WEB_DOMAIN=student.example.com
API_DOMAIN=api.student.example.com
NEXT_PUBLIC_API_URL=https://api.student.example.com/api/v1
CORS_ORIGINS=https://student.example.com

# Neon connection string. Keep the actual hostname here so TLS verifies it.
# Use ?sslmode=require&channel_binding=require and Neon pooled hostname as supplied.
DATABASE_URL=postgresql://USER:PASSWORD@ep-project-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
EGRESS_DATABASE_HOST=ep-project-pooler.REGION.aws.neon.tech
# Include only endpoints actually configured. Database host:5432 is mandatory.
EGRESS_ALLOWED_DESTINATIONS=ep-project-pooler.REGION.aws.neon.tech:5432,openrouter.ai:443,www.googleapis.com:443

# Generate independently: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=
ENCRYPTION_KEY=

AI_ENABLED=true
AI_PROVIDER=openrouter
# OpenRouter exposes a free-model router; provider availability and rate limits vary.
AI_MODEL=
OPENROUTER_API_KEY=

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=studentos


