# StudentOS Web — environment configuration
# Copy this file to .env.local and adjust the values. NEVER commit .env.local.

# Base URL of the StudentOS API (without trailing slash)
# Must match the API's PORT (default 3001). Do NOT point this at the web server.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional Google Identity Services web client ID. Must match the API's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=