# StudentOS API — environment configuration
# Copy this file to .env and fill in the values. NEVER commit .env.
# The API refuses to boot if any required variable is missing.

# ── Database (PostgreSQL — required) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentos?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentos_test?schema=public

# ── Auth — must be a long random string in production ────────────────────────
JWT_SECRET=dev-only-secret-change-in-production
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI ───────────────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o
AI_BASE_URL=

# Provider keys (only the one matching AI_PROVIDER is required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# ── AI Connections — master key for encrypting stored provider credentials ───
# (apps/api/src/lib/encryption.ts). Required; the AI Connections endpoints
# return 500 without it. Any string works — it is SHA-256 hashed to 32 bytes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse a production key here. Rotating it makes existing stored
# credentials undecryptable.
ENCRYPTION_KEY=

# ── AI agent limits — per-turn ceilings on the tool loop ─────────────────────
# These can only *lower* the hard maximums in apps/api/src/modules/ai/agent.ts
# (4 rounds, 12 tool calls, 8 proposed actions); setting a higher value has no
# effect. Leave blank to use the hard maximums.
AI_AGENT_MAX_TOOL_ROUNDS=
AI_AGENT_MAX_TOOL_CALLS=
AI_AGENT_MAX_PROPOSED_ACTIONS=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
