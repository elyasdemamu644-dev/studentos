// This is the StudentOS database schema.
// Every table maps to a blueprint section. Gaps from the original spec are closed here.
//
// MVP scope notes:
//  - Recurring tasks: deferred to v1.1 (see TaskRecurrenceRule, marked @ignore)
//  - File storage: S3-compatible, resources have storageType URL|UPLOAD
//  - Notifications: MVP delivery is IN_APP only
//  - AI: context builder feeds controlled context; conversations/messages persisted

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 1. USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  university     String?
  department     String?
  academicYear   String?
  timezone       String   @default("UTC")
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Auth tokens (refresh token stored here for rotation/invalidation)
  refreshTokens RefreshToken[]

  // Academic structure
  academicYears AcademicYear[]
  semesters     Semester[]     @relation("SemestersByUser")
  courses       Course[]

  // Direct resource ownership (courses, tasks, notes, etc. are under semesters/courses mostly)
  // But some top-level entities belong directly to user:
  tasks         Task[] // standalone tasks not tied to a course
  notes         Note[]
  events        Event[]
  goals         Goal[]
  notifications Notification[]
  studySessions StudySession[]
  resources     Resource[] // top-level resources not under a course
  grades        Grade[]

  // AI
  aiConversations AiConversation[]
  aiMessages      AiMessage[]
  aiConnections   AiConnection[]

  // AI study plans (owned by user but entries belong to tasks)
  aiStudyPlans AiStudyPlan[]

  // Settings (key/value for flexible preferences)
  settings UserSetting[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("user_settings")
}

// ─────────────────────────────────────────────
// 2. ACADEMIC STRUCTURE
// ─────────────────────────────────────────────

model AcademicYear {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // e.g. "2026 / 2027"
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(UPCOMING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  semesters Semester[]

  @@map("academic_years")
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model Semester {
  id             String         @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g. "2026/27 — Semester 1"
  startDate      DateTime
  endDate        DateTime
  status         SemesterStatus @default(UPCOMING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  courses Course[]
  user    User     @relation("SemestersByUser", fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@map("semesters")
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─────────────────────────────────────────────
// 3. COURSES
// ─────────────────────────────────────────────

model Course {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterId  String?
  semester    Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  name        String
  code        String? // e.g. "SE-204"
  description String?
  instructor  String?
  credits     Int? // e.g. 5
  color       String       @default("#6366f1") // hex color, shadcn-compatible
  status      CourseStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Child entities
  tasks         Task[]
  notes         Note[]
  resources     Resource[]
  studySessions StudySession[]
  events        Event[]
  grades        Grade[]

  @@map("courses")
}

enum CourseStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

// ─────────────────────────────────────────────
// 4. TASKS & SUBTASKS
// ─────────────────────────────────────────────

model Task {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String?
  course           Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  type             TaskType     @default(OTHER)
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  dueDate          DateTime?
  estimatedMinutes Int? // estimated duration in minutes
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Subtasks
  subtasks TaskSubtask[]

  // Study sessions that track this task
  studySessions StudySession[]

  // Tags (simple many-to-many via join, or use a tags array column if MVP wants simplicity)
  taskTags TaskTag[]

  @@map("tasks")
}

enum TaskType {
  ASSIGNMENT
  HOMEWORK
  PROJECT
  READING
  PRACTICE
  REVISION
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TaskSubtask {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  status      TaskStatus @default(TODO)
  position    Int        @default(0) // ordering
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("task_subtasks")
}

model TaskTag {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  color     String? // optional tag color
  createdAt DateTime @default(now())

  @@unique([taskId, name])
  @@map("task_tags")
}

