// ─────────────────────────────────────────────
// 5. NOTES
// ─────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String
  content   String // Markdown body
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

// ─────────────────────────────────────────────
// 6. RESOURCES (URL + S3 UPLOAD)
// ─────────────────────────────────────────────

model Resource {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  url          String? // populated when storageType = URL
  storageType  ResourceStorageType @default(URL)
  // When storageType = UPLOAD, these point to S3-compatible storage:
  fileKey      String? // S3 object key (e.g. "studentos/{userId}/resources/{id}/{fileName}")
  fileName     String? // original filename
  fileSize     Int? // bytes
  mimeType     String? // e.g. "application/pdf"
  resourceType ResourceType        @default(OTHER)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("resources")
}

enum ResourceStorageType {
  URL
  UPLOAD
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  SLIDES
  LINK
  DOCUMENT
  OTHER
}

// ─────────────────────────────────────────────
// 7. EVENTS / CALENDAR
// ─────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title       String
  description String?
  type        EventType @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("events")
}

enum EventType {
  CLASS
  EXAM
  ASSIGNMENT
  PROJECT
  STUDY
  MEETING
  PERSONAL
  OTHER
}

// ─────────────────────────────────────────────
// 8. STUDY SESSIONS
// ─────────────────────────────────────────────

model StudySession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  topic           String? // e.g. "Normalization"
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int? // computed from startedAt/endedAt, stored for analytics
  focusRating     Int? // 1-5 stars
  createdAt       DateTime  @default(now())

  @@map("study_sessions")
}

// ─────────────────────────────────────────────
// 9. GOALS & MILESTONES
// ─────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadline    DateTime?
  status      GoalStatus @default(ACTIVE)
  progress    Int        @default(0) // 0-100
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestones GoalMilestone[]

  @@map("goals")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model GoalMilestone {
  id          String          @id @default(cuid())
  goalId      String
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  status      MilestoneStatus @default(TODO)
  position    Int             @default(0)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("goal_milestones")
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────
// 10. GRADES (was missing from §32, added here)
// ─────────────────────────────────────────────

model Grade {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title      String // e.g. "Database Midterm"
  score      Float? // points earned
  maxScore   Float? // points possible
  weight     Float? // weight in course grade (percentage or fraction)
  type       GradeType @default(ASSESSMENT)
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("grades")
}

enum GradeType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  PARTICIPATION
  FINAL
  OTHER
  ASSESSMENT
}

// ─────────────────────────────────────────────
// 11. NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType
  delivery    NotificationDelivery @default(IN_APP) // MVP = IN_APP only
  channel     String? // for future: push, email, sms, telegram (null = in-app)
  status      NotificationStatus   @default(UNREAD)
  readAt      DateTime?
  relatedType String? // e.g. "TASK", "EXAM", "GOAL" — what this notification is about
  relatedId   String? // id of the related entity
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ASSIGNMENT_DUE
  EXAM_REMINDER
  OVERDUE_TASK
  STUDY_REMINDER
  STUDY_PLAN_REMINDER
  GOAL_REMINDER
  GENERAL
}

enum NotificationDelivery {
  IN_APP
  PUSH
  EMAIL
  SMS
  TELEGRAM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

// ─────────────────────────────────────────────
// 12. AI CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────────

model AiConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. "Database normalization session"
  type      AiConversationType @default(CHAT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages AiMessage[]

  @@map("ai_conversations")
}

enum AiConversationType {
  CHAT
  TUTOR
  QUIZ
  STUDY_PLAN
  EXPLAIN
}

model AiMessage {
  id              String         @id @default(cuid())
  conversationId  String
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            AiMessageRole  @default(USER)
  content         String
  // Optional: store the AI's raw context snapshot for debugging/replay
  contextSnapshot String? // JSON-safe string of what was sent to the model
  createdAt       DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─────────────────────────────────────────────
// 12. AI CONNECTIONS (user-owned provider connections)
// ─────────────────────────────────────────────

model AiConnection {
  id                  String   @id @default(cuid()) @map("id")
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            String   @map("provider")
  model               String?  @map("model")
  endpoint            String?  @map("endpoint")
  credentialsEncrypted String  @map("credentials_encrypted")
  enabled             Boolean  @default(true) @map("enabled")
  isActive            Boolean  @default(false) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("ai_connections")
}

// ─────────────────────────────────────────────
// 13. AI STUDY PLANS (created by AI, linked to tasks/events)
// ─────────────────────────────────────────────

model AiStudyPlan {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. "Database Exam Prep — 6 days"
  examDate  DateTime?
  courseId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries AiStudyPlanEntry[]

  @@map("ai_study_plans")
}

model AiStudyPlanEntry {
  id              String               @id @default(cuid())
  studyPlanId     String
  studyPlan       AiStudyPlan          @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  dayNumber       Int // 1-indexed day in the plan
  title           String // e.g. "Chapter 1"
  description     String?
  durationMinutes Int // planned duration
  status          StudyPlanEntryStatus @default(PENDING)
  taskId          String? // if the AI created a task for this entry
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("ai_study_plan_entries")
}

enum StudyPlanEntryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
