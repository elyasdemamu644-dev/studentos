{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["apps/*/dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "apps/api/src/**",
        "apps/api/tests/**",
        "apps/api/prisma/**",
        "package.json",
        "pnpm-lock.yaml"
      ]
    }
  }
}
