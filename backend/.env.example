# StudentOS API — environment configuration
# Copy this file to .env and fill in the values. NEVER commit .env.
# Every name below is read by apps/api/src/config/index.ts; names that are not
# listed there are ignored by the app.

# ── Database (PostgreSQL — required) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentos?schema=public
# Used by vitest (vitest.config.ts) so tests run against a separate database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studentos_test?schema=public

# ── Auth — must be a long random string in production ────────────────────────
# One shared secret signs both the access and refresh tokens; they are
# distinguished by the `type` claim, not by a second key.
JWT_SECRET=dev-only-secret-change-in-production
# Token lifetimes, in SECONDS. Access tokens are short-lived; refresh tokens
# are what keep a session alive (the DB row's expiresAt is checked too).
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Optional: restrict the session cookie to a parent domain on the web side.
COOKIE_DOMAIN=

# ── Google OAuth (optional) ──────────────────────────────────────────────
# Enables POST /auth/google. Only the client id is required — no secret:
# Google's OIDC id_tokens are RS256-signed and verified against Google's
# public JWKS, so nothing is stored on our side.
# GOOGLE_CLIENT_ID=
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting ────────────────────────────────────────────────────────────
# Requests allowed per client IP per window, applied to /api/v1 only.
# Disabled automatically when NODE_ENV=test.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI ───────────────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o
AI_BASE_URL=

# Provider keys (only the one matching AI_PROVIDER is required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# ── AI Connections — master key for encrypting stored provider credentials ───
# (apps/api/src/lib/encryption.ts). Required; the AI Connections endpoints
# return 500 without it. Any string works — it is SHA-256 hashed to 32 bytes.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse a production key here. Rotating it makes existing stored
# credentials undecryptable.
ENCRYPTION_KEY=

# ── AI agent limits — per-turn ceilings on the tool loop ─────────────────────
# These can only *lower* the hard maximums in apps/api/src/modules/ai/agent.ts
# (4 rounds, 12 tool calls, 8 proposed actions); setting a higher value has no
# effect. Leave blank to use the hard maximums.
AI_AGENT_MAX_TOOL_ROUNDS=
AI_AGENT_MAX_TOOL_CALLS=
AI_AGENT_MAX_PROPOSED_ACTIONS=

# Hard ceiling on a single provider request, in milliseconds. A provider that
# stalls is aborted and answered with 504 AI_PROVIDER_TIMEOUT instead of hanging.
AI_REQUEST_TIMEOUT_MS=60000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Proxies in front of the API (Express `trust proxy`). Leave at 0 when the API
# is reached directly. Set to 1 behind nginx/ALB so the rate limiter and the
# logs see the real client IP instead of the proxy's.
TRUST_PROXY=0

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
# Directory for local-disk file storage when S3 is not configured.
# UPLOAD_DIR=./uploads

# ── S3-compatible storage (optional) ─────────────────────────────────────────
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=studentos
# S3_USE_PATH_STYLE=false

# ── Email dispatch (optional) ─────────────────────────────────────────────────
# Enables POST /notifications/:id/email. Opt-in: dispatch answers 503
# EMAIL_NOT_CONFIGURED until EMAIL_ENABLED=true AND SMTP_HOST are set. Mail is
# only ever sent to the authenticated owner's own mailbox (the address is read
# from the database, never from the request), so these credentials cannot be
# turned into an open relay. SMTP_SECURE=true uses implicit TLS (port 465);
# otherwise the server must advertise STARTTLS before AUTH (port 587) — the
# client refuses to send credentials over a plaintext link.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@studentos.local
# Abort an SMTP conversation that stalls longer than this (milliseconds).
EMAIL_TIMEOUT_MS=10000
