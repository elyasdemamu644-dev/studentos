// ─────────────────────────────────────────────
// 5. NOTES
// ─────────────────────────────────────────────
model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  title      String
  content    String // Markdown body
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, resourceId, updatedAt])
  @@map("notes")
}

// ─────────────────────────────────────────────
// 6. RESOURCES (URL + S3 UPLOAD)
// ─────────────────────────────────────────────
model Resource {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  url          String? // populated when storageType = URL
  storageType  ResourceStorageType @default(URL)
  // When storageType = UPLOAD, these point to S3-compatible storage:
  fileKey      String? // S3 object key (e.g. "studentos/{userId}/resources/{id}/{fileName}")
  fileName     String? // original filename
  fileSize     Int? // bytes
  mimeType     String? // e.g. "application/pdf"
  resourceType ResourceType        @default(OTHER)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  artifacts    AiArtifact[]
  progress     ResourceProgress[]
  bookmarks    ResourceBookmark[]
  notes        Note[]

  @@index([userId, createdAt])
  @@map("resources")
}

/**
 * Where a student stopped in a resource.
 *
 * One row per (student, resource), so resuming is a single lookup. The fields
 * are deliberately format-specific: a PDF uses `page`, slides use `slide`,
 * audio/video use `positionSeconds`, and formats without pagination use
 * `percent`. A viewer only writes the fields that apply to it.
 */
model ResourceProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  page            Int?
  slide           Int?
  positionSeconds Float?
  percent         Float?
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, resourceId])
  @@index([userId, updatedAt])
  @@map("resource_progress")
}

/** A student-named place inside a resource (page, slide or timestamp). */
model ResourceBookmark {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId      String
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  label           String
  page            Int?
  slide           Int?
  positionSeconds Float?
  note            String?
  createdAt       DateTime @default(now())

  @@index([userId, resourceId, createdAt])
  @@map("resource_bookmarks")
}

enum ResourceStorageType {
  URL
  UPLOAD
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  SLIDES
  LINK
  DOCUMENT
  OTHER
}

// ─────────────────────────────────────────────
// 7. EVENTS / CALENDAR
// ─────────────────────────────────────────────
model Event {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title       String
  description String?
  type        EventType @default(OTHER)
  startAt     DateTime
  endAt       DateTime?
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Calendar reads are always "this user's events, startAt ascending" (and
  // often a startAt range filter), which this index serves directly.
  @@index([userId, startAt])
  @@map("events")
}

enum EventType {
  CLASS
  EXAM
  ASSIGNMENT
  PROJECT
  STUDY
  MEETING
  PERSONAL
  OTHER
}

// ─────────────────────────────────────────────
// 8. STUDY SESSIONS
// ─────────────────────────────────────────────
model StudySession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  taskId          String?
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  topic           String? // e.g. "Normalization"
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int? // computed from startedAt/endedAt, stored for analytics
  focusRating     Int? // 1-5 stars
  createdAt       DateTime  @default(now())

  // Study history reads filter by owner and sort by startedAt (newest first).
  @@index([userId, startedAt])
  @@map("study_sessions")
}

// ─────────────────────────────────────────────
// 9. GOALS & MILESTONES
// ─────────────────────────────────────────────
model Goal {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadline    DateTime?
  status      GoalStatus      @default(ACTIVE)
  progress    Int             @default(0) // 0-100
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  milestones  GoalMilestone[]

  @@index([userId, status])
  @@map("goals")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model GoalMilestone {
  id          String          @id @default(cuid())
  goalId      String
  goal        Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  status      MilestoneStatus @default(TODO)
  position    Int             @default(0)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([goalId, position])
  @@map("goal_milestones")
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────
// 10. GRADES (was missing from §32, added here)
// ─────────────────────────────────────────────
model Grade {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title      String // e.g. "Database Midterm"
  score      Float? // points earned
  maxScore   Float? // points possible
  weight     Float? // weight in course grade (percentage or fraction)
  type       GradeType @default(ASSESSMENT)
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Gradebook reads filter by owner and sort by recordedAt (newest first).
  @@index([userId, recordedAt])
  @@map("grades")
}

enum GradeType {
  ASSIGNMENT
  EXAM
  QUIZ
  PROJECT
  PARTICIPATION
  FINAL
  OTHER
  ASSESSMENT
}

// ─────────────────────────────────────────────
// 11. NOTIFICATIONS
// ─────────────────────────────────────────────
model Notification {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType
  delivery    NotificationDelivery @default(IN_APP) // MVP = IN_APP only
  channel     String? // for future: push, email, sms, telegram (null = in-app)
  status      NotificationStatus   @default(UNREAD)
  readAt      DateTime?
  relatedType String? // e.g. "TASK", "EXAM", "GOAL" — what this notification is about
  relatedId   String? // id of the related entity
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ASSIGNMENT_DUE
  EXAM_REMINDER
  OVERDUE_TASK
  STUDY_REMINDER
  STUDY_PLAN_REMINDER
  GOAL_REMINDER
  GENERAL
}

enum NotificationDelivery {
  IN_APP
  PUSH
  EMAIL
  SMS
  TELEGRAM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

// ─────────────────────────────────────────────
// 12. AI CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────────
model AiConversation {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String // e.g. "Database normalization session"
  type           AiConversationType @default(CHAT)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  messages       AiMessage[]
  pendingActions AiPendingAction[]
  aiArtifacts    AiArtifact[]
  missions       AiMission[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

enum AiConversationType {
  CHAT
  TUTOR
  QUIZ
  STUDY_PLAN
  EXPLAIN
}

model AiMessage {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    AiConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            AiMessageRole     @default(USER)
  content         String
  // Optional: store the AI's raw context snapshot for debugging/replay
  contextSnapshot String? // JSON-safe string of what was sent to the model
  attachmentIds   String[]          @default([])
  createdAt       DateTime          @default(now())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts       AiArtifact[]
  pendingActions  AiPendingAction[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─────────────────────────────────────────────
// 12b. AI MISSIONS (persistent multi-step missions)
// ─────────────────────────────────────────────

enum AiMissionStatus {
  QUEUED
  RUNNING
  WAITING
  PARTIAL
  FAILED_RECOVERABLE
  FAILED_TERMINAL
  CANCEL_REQUESTED
  CANCELLED
  COMPLETED
}

enum AiMissionStepStatus {
  PENDING
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED_RECOVERABLE
  FAILED_TERMINAL
  SKIPPED
  CANCELLED
}

model AiMission {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     AiConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  objective        String
  contextSnapshot  Json?
  status           AiMissionStatus   @default(QUEUED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  terminalError    String?
  steps            AiMissionStep[]

  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([conversationId])
  @@map("ai_missions")
}

model AiMissionStep {
  id              String              @id @default(cuid())
  missionId       String
  mission         AiMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stepOrder       Int
  toolName        String
  description     String
  arguments       Json
  dependsOn       String[]            @default([])
  status          AiMissionStepStatus @default(PENDING)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(3)
  idempotencyKey  String?             @unique
  // The proposal this step is waiting on, when a write needed the student's
  // approval. Nullable: a step that runs no confirmation has no proposal.
  pendingActionId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  result          Json?
  error           String?
  verification    Json?

  @@index([missionId, stepOrder])
  @@index([missionId, status])
  @@index([pendingActionId])
  @@unique([missionId, stepOrder])
  @@map("ai_mission_steps")
}

// ─────────────────────────────────────────────
// 12. AI CONNECTIONS (user-owned provider connections)
// ─────────────────────────────────────────────
model AiConnection {
  id                   String   @id @default(cuid()) @map("id")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String   @map("provider")
  model                String?  @map("model")
  endpoint             String?  @map("endpoint")
  credentialsEncrypted String   @map("credentials_encrypted")
  enabled              Boolean  @default(true) @map("enabled")
  isActive             Boolean  @default(false) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("ai_connections")
}

// ─────────────────────────────────────────────
// 13. AI STUDY PLANS (created by AI, linked to tasks/events)
// ─────────────────────────────────────────────
model AiStudyPlan {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. "Database Exam Prep — 6 days"
  examDate  DateTime?
  courseId  String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  entries   AiStudyPlanEntry[]

  @@index([userId, updatedAt])
  @@map("ai_study_plans")
}

model AiStudyPlanEntry {
  id              String               @id @default(cuid())
  studyPlanId     String
  studyPlan       AiStudyPlan          @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  dayNumber       Int // 1-indexed day in the plan
  title           String // e.g. "Chapter 1"
  description     String?
  durationMinutes Int // planned duration
  status          StudyPlanEntryStatus @default(PENDING)
  taskId          String? // if the AI created a task for this entry
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("ai_study_plan_entries")
}

enum StudyPlanEntryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// AI Pending Actions
model AiPendingAction {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  title          String
  actions        Json
  status         String         @default("PENDING")
  result         Json?
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  decidedAt      DateTime?
  updatedAt      DateTime       @updatedAt

  @@index([userId, conversationId, status])
  @@index([conversationId, createdAt])
  @@map("ai_pending_actions")
}

// AI Artifacts (generated files)
model AiArtifact {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  resourceId     String?
  resource       Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  mimeType       String?
  size           Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, conversationId, createdAt])
  @@map("ai_artifacts")
}

// ─────────────────────────────────────────────
// 14. AI MEMORIES (user-controlled assistant memory)
// ─────────────────────────────────────────────
// Facts about the student the assistant may reuse across conversations.
// Nothing here is extracted automatically: a row is created either by the
// student in Settings or through the confirmation-gated save_memory tool, so
// ordinary chat never silently retains anything.

enum MemoryCategory {
  PREFERENCE
  ACADEMIC
  GOALS
  SCHEDULE
  OTHER
}

enum MemoryProvenance {
  USER // saved by the student directly
  AI // saved by the assistant after the student confirmed
}

model AiMemory {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   MemoryCategory   @default(OTHER)
  content    String
  provenance MemoryProvenance @default(USER)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // The settings list groups by category; the prompt loader reads the newest
  // bounded slice per user.
  @@index([userId, category])
  @@index([userId, updatedAt])
  @@map("ai_memories")
}

// ─────────────────────────────────────────────
// 15. AI MODEL ROUTING (unified provider + model routing)
// ─────────────────────────────────────────────
//
// One shared routing architecture. The routing policy is the per-user decision
// of *how* a model is chosen for every AI feature, so no feature bypasses it:
//
//  * FIXED — always the student's explicit connection + model.
//  * AUTO  — the engine chooses from the candidate connections/models under the
//            policy's allow/deny lists, priorities and free-only/spending rules.
//
// Supporting rows:
//  * AiModelPreference — the student's ordered allow/deny + priority per model,
//    and the per-conversation override, all in one table.
//  * AiModelCapability — capability + evidence metadata (verified / provider-
//    reported / user-configured / unknown). A text test never verifies images.
//  * AiProviderHealth — bounded rolling health samples per connection.
//  * AiUsageRecord — usage/cost telemetry per turn (tokens, cost, provider).
//
// All rows are additive; existing AiConnection/UserSetting rows are untouched.

enum AiRoutingStrategy {
  FIXED // never switch; the pinned connection/model or an unavailable state
  AUTO // choose per the policy (presets, priorities, allow/deny, fallback)
}

enum AiModelCapabilityKind {
  TEXT
  VISION
  TOOLS
  STRUCTURED_OUTPUT
  LONG_CONTEXT
  REASONING
}

/**
 * How a capability claim is known to be true. Ordered from strongest to weakest:
 * a `VERIFIED` claim is one we exercised, never inferred from a text reply.
 */
enum AiCapabilityEvidence {
  VERIFIED // we exercised the capability against this exact model and it worked
  PROVIDER_REPORTED // the provider's own model metadata declares it
  USER_CONFIGURED // the student asserted it when configuring the connection
  UNKNOWN // we do not know; must not be treated as supported
}

enum AiHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

model AiRoutingPolicy {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy  AiRoutingStrategy @default(AUTO)
  // The pinned connection/model for FIXED. Null means "not yet chosen".
  fixedConnectionId String?
  fixedModel        String?
  // When true the engine may only consider free models.
  freeOnly          Boolean @default(false)
  // Spend ceiling in cents for the rolling window; null = no user ceiling.
  spendCeilingCents Int?
  spendWindowDays   Int     @default(30)
  // "Auto only when configured": when false, AUTO never silently substitutes a
  // model — an unavailable state is surfaced instead. Default true.
  allowAutoFallback Boolean @default(true)
  // Privacy: when true, no turn may be sent to an external provider. Enforced
  // against the actual execution destination, never a UI hint.
  externalProcessingDisabled Boolean @default(false)
  // Ordered preference preset applied by the engine (e.g. "quality", "speed",
  // "cost"). Free-form so the UI can add presets without a migration.
  preset            String?
  // Ordered fallback connection ids the engine may try, after the primary.
  fallbackOrder     String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("ai_routing_policies")
}

/**
 * One model's routing preference for a user. `scope` distinguishes the user's
 * global list from a per-conversation override, so the precedence rule
 * (conversation → feature default → global default → Auto) reads from one place.
 */
enum AiModelPreferenceScope {
  GLOBAL
  CONVERSATION
}

model AiModelPreference {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope          AiModelPreferenceScope @default(GLOBAL)
  // Set only for CONVERSATION scope; the conversation this override belongs to.
  conversationId String?
  provider       String
  model          String
  connectionId   String?
  // Lower number = higher priority. Null means unordered.
  priority       Int?
  allowed        Boolean                @default(true)
  // Capability assertions the student set for this model (UNKNOWN by default).
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([userId, scope, conversationId, provider, model])
  @@index([userId, scope])
  @@index([userId, conversationId])
  @@map("ai_model_preferences")
}

/**
 * Capability + evidence metadata for a model. There is at most one row per
 * (provider, model); a deployment-wide row (userId null) records what we have
 * verified, and a per-user row narrows it for a specific connection.
 */
model AiModelCapability {
  id           String              @id @default(cuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  provider     String
  model        String
  kind         AiModelCapabilityKind
  evidence     AiCapabilityEvidence @default(UNKNOWN)
  // A bounded, human-readable note about how the claim was established.
  note         String?
  // When the capability was last exercised (VERIFIED rows only).
  verifiedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, connectionId, provider, model, kind])
  @@index([provider, model])
  @@index([userId])
  @@map("ai_model_capabilities")
}

/**
 * A bounded rolling health sample for a connection. The engine reads the newest
 * samples to skip a connection that is currently failing, and the UI shows the
 * latest status. Samples are trimmed by the retention sweep.
 */
model AiProviderHealth {
  id           String         @id @default(cuid())
  userId       String
  connectionId String
  provider     String
  status       AiHealthStatus @default(UNKNOWN)
  latencyMs    Int?
  // A sanitized, credential-free message. Never provider internals or keys.
  message      String?
  // Error class code (e.g. AI_PROVIDER_TIMEOUT) when status is not HEALTHY.
  code         String?
  checkedAt    DateTime       @default(now())

  @@index([userId, connectionId, checkedAt])
  @@index([connectionId, checkedAt])
  @@map("ai_provider_health")
}

/**
 * Usage/cost telemetry for one provider turn. Token counts and cost come from
 * the provider's own usage block when present; `estimated` marks a value we
 * derived from a static price table rather than the provider's report.
 */
model AiUsageRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  connectionId   String?
  provider       String
  model          String
  feature        String   @default("chat")
  promptTokens   Int      @default(0)
  completionTokens Int    @default(0)
  totalTokens    Int      @default(0)
  // Cost in cents (integer to avoid float drift). Null when unknown.
  costCents      Int?
  estimated      Boolean  @default(false)
  free           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, provider, model])
  @@index([conversationId])
  @@map("ai_usage_records")
}
