{
  "name": "@tutor-walle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --stack-size=8000 ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.json --noEmit && esbuild src/server.ts src/utils/egress-gateway.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --alias:@tutor-walle/shared/schemas=../packages/shared/src/schemas --outdir=dist --entry-names=[name]",
    "start": "node dist/server.js",
    "start:egress": "node dist/egress-gateway.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.0.0",
    "@tutor-walle/shared": "workspace:*",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "jose": "^5.0.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.0.0",
    "undici": "^6.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.0",
    "esbuild": "^0.25.11",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
